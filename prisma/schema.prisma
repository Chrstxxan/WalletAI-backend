// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

model User {
  id                  Int                   @id @default(autoincrement())
  email               String                @unique
  password            String
  name                String?
  lastSeenMonth       Int?
  lastSeenYear        Int?
  onboardingCompletedAt DateTime?
  transactions        Transaction[]
  financialProfile    FinancialProfile?
  incomeSources       IncomeSource[]
  fixedExpenses       FixedExpense[]
  chatMessages        ChatMessage[]
  creditCards         CreditCard[]
  fixedExpenseRecords FixedExpenseRecord[]
  incomeRecords       IncomeRecord[]
  categoryBudgets     CategoryBudget[]
  goals               Goal[]
  benefitWallets      BenefitWallet[]
}

model CreditCard {
  id            Int            @id @default(autoincrement())
  userId        Int
  name          String
  limit         Float
  user          User           @relation(fields: [userId], references: [id])
  invoices      CardInvoice[]
  fixedExpenses FixedExpense[]
}

model CardInvoice {
  id     Int               @id @default(autoincrement())
  cardId Int
  month  Int
  year   Int
  card   CreditCard        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  items  CardInvoiceItem[]

  @@unique([cardId, month, year])
}

model CardInvoiceItem {
  id                 Int           @id @default(autoincrement())
  invoiceId          Int
  fixedExpenseId     Int?
  description        String
  installmentAmount  Float
  currentInstallment Int
  totalInstallments  Int
  category           String?
  invoice            CardInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fixedExpense       FixedExpense? @relation(fields: [fixedExpenseId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, fixedExpenseId])
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model FinancialProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  workingCapital Float    @default(0)
  savingsGoal    Float    @default(0)
  creditTypes    Json?
  user           User     @relation(fields: [userId], references: [id])
}

model IncomeSource {
  id          Int            @id @default(autoincrement())
  userId      Int
  description String
  amount      Float
  recorrente  Boolean        @default(true)
  month       Int?
  year        Int?
  user        User           @relation(fields: [userId], references: [id])
  records     IncomeRecord[]
}

model IncomeRecord {
  id             Int          @id @default(autoincrement())
  incomeSourceId Int
  userId         Int
  month          Int
  year           Int
  amount         Float
  description    String
  isReceived     Boolean      @default(false)
  receivedAt     DateTime?
  incomeSource   IncomeSource @relation(fields: [incomeSourceId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([incomeSourceId, month, year])
}

model FixedExpense {
  id           Int                  @id @default(autoincrement())
  userId       Int
  description  String
  amount       Float
  recorrente   Boolean              @default(true)
  month        Int?
  year         Int?
  creditCardId Int?
  user         User                 @relation(fields: [userId], references: [id])
  creditCard   CreditCard?          @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  records      FixedExpenseRecord[]
  invoiceItems CardInvoiceItem[]
}

model FixedExpenseRecord {
  id             Int          @id @default(autoincrement())
  fixedExpenseId Int
  userId         Int
  month          Int
  year           Int
  amount         Float
  description    String
  isPaid         Boolean      @default(false)
  paidAt         DateTime?
  fixedExpense   FixedExpense @relation(fields: [fixedExpenseId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([fixedExpenseId, month, year])
}

model Category {
  id           Int              @id @default(autoincrement())
  name         String           @unique
  transactions Transaction[]
  budgets      CategoryBudget[]
}

model CategoryBudget {
  id         Int      @id @default(autoincrement())
  userId     Int
  categoryId Int
  limit      Float
  user       User     @relation(fields: [userId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId])
}

model Goal {
  id            Int    @id @default(autoincrement())
  userId        Int
  description   String
  targetAmount  Float
  currentAmount Float  @default(0)
  user          User   @relation(fields: [userId], references: [id])
}

model Transaction {
  id              Int            @id @default(autoincrement())
  amount          Float
  type            String
  description     String
  date            DateTime       @default(now())
  userId          Int
  categoryId      Int
  benefitWalletId Int?
  user            User           @relation(fields: [userId], references: [id])
  category        Category       @relation(fields: [categoryId], references: [id])
  benefitWallet   BenefitWallet? @relation(fields: [benefitWalletId], references: [id], onDelete: SetNull)
}

model BenefitWallet {
  id           Int           @id @default(autoincrement())
  userId       Int
  type         String
  balance      Float         @default(0)
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@unique([userId, type])
}